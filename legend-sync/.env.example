# Base URL of the ClashKing API. No trailing slash.
CLASHKING_API_BASE=https://api.clashk.ing

# Official Clash of Clans API
# Use a dedicated developer account. The login creates and rotates the IP bound key by itself.
COC_EMAIL=
COC_PASSWORD=
# Give every environment its own key name (for example legend-sync-dev and legend-sync-prod).
# Keys with this name bound to a different IP are revoked on login, so two machines sharing a name would keep deleting each other's key.
COC_KEY_NAME=legend-sync
COC_KEY_COUNT=1
